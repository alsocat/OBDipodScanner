---
 apps/plugins/boost_gauge.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/apps/plugins/boost_gauge.c b/apps/plugins/boost_gauge.c
index 2e54bf5..7d03de2 100644
--- a/apps/plugins/boost_gauge.c
+++ b/apps/plugins/boost_gauge.c
@@ -577,7 +577,7 @@ static void draw_codes(void)
     rb->lcd_set_foreground(DIM);
     bool asked = TIME_BEFORE(*rb->current_tick, scan_asked_tick + 10 * HZ);
     put_centered(LCD_WIDTH / 2, LCD_HEIGHT - 18,
-                 scan_steps ? "" : asked ? "Scan requested (car stopped)"
+                 scan_steps ? "" : asked ? "Scan requested..."
                                          : "SELECT: scan now");
 }
 
