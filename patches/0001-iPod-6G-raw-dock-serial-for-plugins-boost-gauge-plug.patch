+}
+
+#ifdef HAVE_SERIAL_RAW_RX
+void serial_raw_rx(int rate)
+{
+    int old = disable_irq_save();
+    raw_head = raw_tail = 0;
+    raw_rate = rate;
+    restore_irq(old);
+    port_set_rate(CUR_RATE());
+}
+
+int serial_raw_read(unsigned char *buf, int len)
+{
+    int n = 0;
+    unsigned int tail = raw_tail;
+    while (n < len && tail != raw_head) {
+        buf[n++] = raw_buf[tail];
+        tail = (tail + 1) % sizeof(raw_buf);
+    }
+    raw_tail = tail;
+    return n;
+}
+#endif
