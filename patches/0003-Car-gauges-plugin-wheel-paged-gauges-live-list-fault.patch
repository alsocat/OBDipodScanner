+static void draw(void)
+{
+    rb->lcd_set_background(BG);
+    rb->lcd_clear_display();
+    if (page < NGAUGES)
+        draw_gauge(page);
+    else if (page == PAGE_LIVE)
+        draw_live();
+    else
+        draw_codes();
+    draw_page_dots();
     rb->lcd_update();
 }
 
